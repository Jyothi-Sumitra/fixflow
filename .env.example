# Groq API Key for LangGraph LLM nodes
GROQ_API_KEY=gsk_your_groq_api_key_here

# Allowed Frontend Origins for CORS (comma-separated, or * for open)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# SQLite Database File Location (persistent disk mount recommended in production)
DATABASE_PATH=fixflow.db

# Server Port (used by cloud hosting platforms such as Render, Railway, Fly.io)
PORT=8000
