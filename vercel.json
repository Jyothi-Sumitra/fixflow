{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "entrypoint": "app/api.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/tickets/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/tickets",
      "destination": { "service": "api" }
    },
    {
      "source": "/health",
      "destination": { "service": "api" }
    },
    {
      "source": "/docs",
      "destination": { "service": "api" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
